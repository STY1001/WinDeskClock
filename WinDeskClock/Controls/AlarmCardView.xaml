<UserControl x:Class="WinDeskClock.Controls.AlarmCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ui:CardAction x:Name="RootCard" IsChevronVisible="False" Margin="0,0,0,10" Padding="10"
                    PreviewMouseDown="RootCard_PreviewMouseDown">
        <Grid x:Name="MainGrid">
            <!-- Collapsed view -->
            <Grid x:Name="SmallGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="32"
                           FontFamily="Segoe UI Variable Display SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="10,0,20,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding NameDisplay}" FontSize="18"
                           FontFamily="Segoe UI SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding EtaSummary}" FontSize="14"
                           FontFamily="Segoe UI" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ui:ToggleSwitch Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
            </Grid>

            <!-- Expanded (edit) view -->
            <Grid x:Name="BigGrid" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderEnabled="True" PlaceholderText="{Binding NamePlaceholder}"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                        <ui:TextBox.Icon>
                            <ui:ImageIcon Source="pack://application:,,,/Resources/Icons/rename.png" Width="16" Height="16"/>
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                    <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hour : Minute editor -->
                    <Grid Grid.Column="0">
                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="10"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ui:Button Grid.Column="0" Grid.Row="0" Appearance="Secondary" HorizontalAlignment="Stretch" Click="HourUpBtn_Click">
                                    <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/up.png" Width="16" Height="16"/></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Grid.Column="0" Grid.Row="2" Appearance="Secondary" HorizontalAlignment="Stretch" Click="HourDownBtn_Click">
                                    <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/down.png" Width="16" Height="16"/></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Grid.Column="2" Grid.Row="0" Appearance="Secondary" HorizontalAlignment="Stretch" Click="MinuteUpBtn_Click">
                                    <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/up.png" Width="16" Height="16"/></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Grid.Column="2" Grid.Row="2" Appearance="Secondary" HorizontalAlignment="Stretch" Click="MinuteDownBtn_Click">
                                    <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/down.png" Width="16" Height="16"/></ui:Button.Icon>
                                </ui:Button>

                                <Grid Grid.Column="0" Grid.Row="1" Width="50" Height="50" ClipToBounds="True"
                                      VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HourText" Text="{Binding DraftHourDisplay}" FontSize="48" LineHeight="50"
                                               LineStackingStrategy="BlockLineHeight" FontFamily="Segoe UI Variable Display SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" Grid.Row="1" Text=":" FontSize="48" LineHeight="50"
                                           LineStackingStrategy="BlockLineHeight" FontFamily="Segoe UI Variable Display SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>

                                <Grid Grid.Column="2" Grid.Row="1" Width="50" Height="50" ClipToBounds="True"
                                      VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="MinuteText" Text="{Binding DraftMinuteDisplay}" FontSize="48" LineHeight="50"
                                               LineStackingStrategy="BlockLineHeight" FontFamily="Segoe UI Variable Display SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Days + sound -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ToggleButton Content="1" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftIsOnce, Mode=OneWay}" Click="OnceToggle_Click"/>
                                <ToggleButton Content="{Binding MondayAbbreviation}" Margin="0,0,3,0" Tag="1"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftMonday, Mode=OneWay}" Click="DayToggle_Click"/>
                                <ToggleButton Content="{Binding TuesdayAbbreviation}" Margin="0,0,3,0" Tag="2"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftTuesday, Mode=OneWay}" Click="DayToggle_Click"/>
                                <ToggleButton Content="{Binding WednesdayAbbreviation}" Margin="0,0,3,0" Tag="3"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftWednesday, Mode=OneWay}" Click="DayToggle_Click"/>
                                <ToggleButton Content="{Binding ThursdayAbbreviation}" Margin="0,0,3,0" Tag="4"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftThursday, Mode=OneWay}" Click="DayToggle_Click"/>
                                <ToggleButton Content="{Binding FridayAbbreviation}" Margin="0,0,3,0" Tag="5"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftFriday, Mode=OneWay}" Click="DayToggle_Click"/>
                                <ToggleButton Content="{Binding SaturdayAbbreviation}" Margin="0,0,3,0" Tag="6"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftSaturday, Mode=OneWay}" Click="DayToggle_Click"/>
                                <ToggleButton Content="{Binding SundayAbbreviation}" Margin="0,0,3,0" Tag="7"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display Regular"
                                              IsChecked="{Binding DraftSunday, Mode=OneWay}" Click="DayToggle_Click"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" IsChecked="{Binding DraftSoundEnabled, Mode=TwoWay}"/>
                                <ComboBox x:Name="SoundComboBox" Grid.Column="1" Width="234"
                                          IsEnabled="{Binding DraftSoundEnabled}" SelectionChanged="SoundComboBox_SelectionChanged">
                                    <ComboBoxItem x:Name="DefaultSoundItem" Content="{Binding DefaultSoundLabel}"/>
                                    <ComboBoxItem x:Name="CustomSoundItem" Content="{Binding DraftCustomSoundLabel}"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Content="{Binding DeleteLabel}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Stretch" Appearance="Secondary" Click="DeleteBtn_Click">
                        <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/delete.png" Width="16" Height="16"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Grid.Column="1" Content="{Binding CancelLabel}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Stretch" Appearance="Secondary" Margin="10,0,10,0" Click="CancelBtn_Click">
                        <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/cross.png" Width="16" Height="16"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Grid.Column="2" Content="{Binding SaveLabel}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Stretch" Appearance="Primary" Click="SaveBtn_Click">
                        <ui:Button.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Icons/checkmark.png" Width="16" Height="16"/></ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Grid>
        </Grid>
    </ui:CardAction>
</UserControl>
