<Page x:Class="WDC.Weather.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WDC.Weather"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="485"
      d:DesignWidth="1180"
      Title="Settings">
    <!-- Don't touch here (BEGIN) -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <!-- Don't touch here (END) -->

    <Grid>
        <ScrollViewer PanningMode="VerticalOnly">
            <StackPanel>
                <Grid HorizontalAlignment="Stretch"
                      Margin="20,10,20,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Location"
                               FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Grid.Column="0"
                               Margin="0,0,10,0"
                               x:Name="LocationText" />
                    <Separator HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Grid.Column="1" />
                </Grid>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/location.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Location"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="LocationTitle" />
                                <TextBlock Text="Select your location"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           x:Name="LocationDesc" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:AutoSuggestBox Grid.Row="0"
                                           QuerySubmitted="LocationBox_QuerySubmitted"
                                           PlaceholderText="Search for a city"
                                           x:Name="LocationBox"
                                           SuggestionChosen="LocationBox_SuggestionChosen" />
                    </Grid>
                </ui:CardControl>
                <Grid HorizontalAlignment="Stretch"
                      Margin="20,10,20,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Units"
                               FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Grid.Column="0"
                               Margin="0,0,10,0"
                               x:Name="UnitsText" />
                    <Separator HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Grid.Column="1" />
                </Grid>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/hashtag.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Decimal numbers mode"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="DecimalTitle" />
                                <TextBlock Text="Enable this settings to use decimal numbers instead of using rounded integer (can cause UI bug)"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           x:Name="LDecimalDesc" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="DecimalSwitch"/>
                </ui:CardControl>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/distance.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Distance"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="DistanceTitle" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="DistanceBox"
                              SelectionChanged="DistanceBox_SelectionChanged">
                        <ComboBoxItem Content="M"
                                      x:Name="DistanceM" />
                        <ComboBoxItem Content="Km"
                                      x:Name="DistanceKm" />
                        <ComboBoxItem Content="Miles"
                                      x:Name="DistanceMiles" />
                    </ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/speed.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Speed"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="SpeedTitle" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="SpeedBox"
                              SelectionChanged="SpeedBox_SelectionChanged">
                        <ComboBoxItem Content="M/s"
                                      x:Name="SpeedMs" />
                        <ComboBoxItem Content="Km/h"
                                      x:Name="SpeedKph" />
                        <ComboBoxItem Content="Miles/h"
                                      x:Name="SpeedMph" />
                    </ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/temperature.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Temperature"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="TemperatureTitle" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="TemperatureBox"
                              SelectionChanged="TemperatureBox_SelectionChanged">
                        <ComboBoxItem Content="°C"
                                      x:Name="TemperatureC" />
                        <ComboBoxItem Content="°F"
                                      x:Name="TemperatureF" />
                    </ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/hygrometer.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Precipitation"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="PrecipitationTitle" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="PrecipitationBox"
                              SelectionChanged="PrecipitationBox_SelectionChanged">
                        <ComboBoxItem Content="mm"
                                      x:Name="PrecipitationMm" />
                        <ComboBoxItem Content="inch"
                                      x:Name="PrecipitationInch" />
                    </ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="15,0,15,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/WDC.Weather;component/Resources/icons/airquality.png"
                                   Width="32"
                                   Height="32" />
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Air Quality"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Segoe UI SemiBold"
                                           x:Name="AIQTitle" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="AIQBox"
                              SelectionChanged="AIQBox_SelectionChanged">
                        <ComboBoxItem Content="USAQI"
                                      x:Name="AIQUSAIQ" />
                        <ComboBoxItem Content="EUAQI"
                                      x:Name="AIQEUAQI" />
                    </ComboBox>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
